{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "paths": {
      "@talent/db": ["../../packages/db/src/client.ts"],
      "@talent/api-spec": ["../../packages/api-spec/openapi.yaml"]
    }
  },
  "include": ["src/**/*"]
}
